# ==============================================================================
# SCELTA MAKEUP — Configurazione Ambiente & Credenziali
# Progetto: Scelta Makeup Boutique (Federica Cesiano — Via dei Pellegrini 28/29, Napoli)
#
# ⚠️ ATTENZIONE: VINCOLO TASSATIVO DI ISOLAMENTO (ZERO CONTAMINAZIONE)
# Non inserire MAI in questo file (o in .env.local) URL, CHIAVI o CREDENZIALI
# relative ad altri progetti (es. Isabel Pepe).
# Tutte le tabelle di Scelta Makeup utilizzano il prefisso dedicato 'scelta_'.
# L'utilizzo accidentale di chiavi di altri progetti comporterebbe la violazione
# dell'isolamento dei dati e il rischio di corruzione del database.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Dedicato Scelta Makeup (https://app.supabase.com)
# Configura queste variabili dopo aver creato il nuovo progetto Supabase autonomo per Scelta Makeup.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-scelta-makeup-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-scelta-makeup-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-scelta-makeup-service-role-key

# ------------------------------------------------------------------------------
# 2. Resend — Notifiche Email Transazionali di Lusso
# In modalità locale senza chiave, lib/resendService.ts opera in modalità anteprima/simulazione.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Scelta Makeup <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. Evolution API — WhatsApp Boutique Anti-Ban (+39 348 381 6516)
# In modalità locale senza chiave, lib/whatsappQueueService.ts simula l'invio con delay umano 20-45s.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EVOLUTION_API_URL=https://evolution.creativia.cloud
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_INSTANCE_NAME=scelta-makeup-store

# ------------------------------------------------------------------------------
# 4. Registratore Telematico Fiscale (IP Statico su Rete Wi-Fi Negozio)
# Indirizzo IP stampante fiscale Epson FP-81II RT (ePOS XML over HTTP)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CASSA_RT_IP=http://192.168.1.150
